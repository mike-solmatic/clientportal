<!DOCTYPE html>
<html>
  <head>
    <title>Admin | SellerHub</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-gray-50 min-h-screen">
    <div class="flex h-screen overflow-hidden">
      <!-- Sidebar -->
      <aside class="w-64 bg-slate-900 text-white flex flex-col flex-shrink-0">
        <div class="px-6 py-5 border-b border-slate-700">
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 bg-purple-500 rounded-lg flex items-center justify-center font-bold text-lg">A</div>
            <div>
              <div class="font-semibold text-sm">SellerHub Admin</div>
              <div class="text-slate-400 text-xs"><%= current_user.display_name %></div>
            </div>
          </div>
        </div>
        <nav class="flex-1 px-4 py-6 space-y-1 overflow-y-auto">
          <%= admin_nav_link "Dashboard", admin_dashboard_path, icon: "grid" %>
          <%= admin_nav_link "Sellers", admin_sellers_path, icon: "store" %>
          <%= admin_nav_link "All Users", admin_users_path, icon: "users" %>
        </nav>
        <div class="px-4 py-4 border-t border-slate-700">
          <div class="text-slate-400 text-xs mb-2"><%= current_user.email %></div>
          <%= link_to "Sign Out", destroy_user_session_path, data: { "turbo-method": :delete }, class: "flex items-center gap-2 text-slate-400 hover:text-white text-sm transition-colors" %>
        </div>
      </aside>

      <!-- Main content -->
      <div class="flex-1 flex flex-col overflow-hidden">
        <header class="bg-white border-b border-gray-200 px-8 py-4 flex items-center justify-between flex-shrink-0">
          <h1 class="text-xl font-semibold text-gray-800"><%= content_for(:page_title) || "Admin Dashboard" %></h1>
          <div class="flex items-center gap-4">
            <span class="bg-purple-100 text-purple-700 text-xs px-2 py-1 rounded-full font-medium">Admin</span>
            <span class="text-sm text-gray-500"><%= Date.current.strftime("%B %d, %Y") %></span>
          </div>
        </header>

        <% if notice %>
          <div class="mx-8 mt-4 bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded-lg flex items-center gap-2">
            <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <%= notice %>
          </div>
        <% end %>
        <% if alert %>
          <div class="mx-8 mt-4 bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-lg flex items-center gap-2">
            <svg class="w-4 h-4 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            <%= alert %>
          </div>
        <% end %>

        <main class="flex-1 overflow-y-auto p-8">
          <%= yield %>
        </main>
      </div>
    </div>
  </body>
</html>
