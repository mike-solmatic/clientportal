<% content_for :page_title, @seller.display_name %>

<div class="flex items-center gap-4 mb-6">
  <%= link_to admin_sellers_path, class: "text-gray-400 hover:text-gray-600" do %>
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
  <% end %>
  <div class="flex-1 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <div class="w-12 h-12 bg-purple-100 rounded-full flex items-center justify-center text-purple-700 font-bold text-lg">
        <%= @seller.display_name.first(2).upcase %>
      </div>
      <div>
        <h2 class="text-lg font-bold text-gray-800"><%= @seller.display_name %></h2>
        <p class="text-sm text-gray-400"><%= @seller.email %></p>
      </div>
    </div>
    <div class="flex gap-2 items-center">
      <%= @seller.active? ? (content_tag :span, "Active", class: "text-xs bg-green-100 text-green-700 px-2 py-1 rounded-full") : (content_tag :span, "Inactive", class: "text-xs bg-red-100 text-red-700 px-2 py-1 rounded-full") %>
      <%= link_to edit_admin_seller_path(@seller), class: "border border-gray-300 text-gray-700 px-4 py-2 rounded-lg text-sm hover:bg-gray-50" %>
      <%= button_to toggle_active_admin_seller_path(@seller), method: :patch,
          class: "#{@seller.active? ? 'bg-red-100 text-red-700 hover:bg-red-200' : 'bg-green-100 text-green-700 hover:bg-green-200'} px-4 py-2 rounded-lg text-sm font-medium" do %>
        <%= @seller.active? ? "Deactivate" : "Activate" %>
      <% end %>
    </div>
  </div>
</div>

<!-- Stats -->
<div class="grid grid-cols-3 gap-4 mb-6">
  <div class="bg-white rounded-xl border border-gray-200 p-5 text-center">
    <p class="text-3xl font-bold text-gray-900"><%= @customers_count %></p>
    <p class="text-sm text-gray-500 mt-1">Customers</p>
  </div>
  <div class="bg-white rounded-xl border border-gray-200 p-5 text-center">
    <p class="text-3xl font-bold text-gray-900"><%= @orders_count %></p>
    <p class="text-sm text-gray-500 mt-1">Total Orders</p>
  </div>
  <div class="bg-white rounded-xl border border-gray-200 p-5 text-center">
    <p class="text-3xl font-bold text-green-600"><%= currency(@total_revenue) %></p>
    <p class="text-sm text-gray-500 mt-1">Total Revenue</p>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <!-- Recent Orders -->
  <div class="lg:col-span-2 bg-white rounded-xl shadow-sm border border-gray-200">
    <div class="px-6 py-4 border-b border-gray-200">
      <h3 class="font-semibold text-gray-800">Recent Orders</h3>
    </div>
    <% if @recent_orders.empty? %>
      <div class="py-8 text-center text-gray-400 text-sm">No orders yet</div>
    <% else %>
      <table class="w-full">
        <thead class="bg-gray-50 border-b border-gray-100">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Order #</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Customer</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Status</th>
            <th class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase">Total</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @recent_orders.each do |order| %>
            <tr>
              <td class="px-6 py-3 text-sm font-mono text-gray-800"><%= order.order_number %></td>
              <td class="px-6 py-3 text-sm text-gray-600"><%= order.customer.name %></td>
              <td class="px-6 py-3"><%= status_badge(order.status) %></td>
              <td class="px-6 py-3 text-sm font-medium text-gray-800 text-right"><%= currency(order.total) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>

  <!-- Seller Info + Monthly Stats -->
  <div class="space-y-6">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
      <h3 class="font-semibold text-gray-800 mb-4">Seller Info</h3>
      <div class="space-y-3 text-sm">
        <div>
          <p class="text-gray-400 text-xs">Company</p>
          <p class="text-gray-700"><%= @seller.company_name.presence || "—" %></p>
        </div>
        <div>
          <p class="text-gray-400 text-xs">Phone</p>
          <p class="text-gray-700"><%= @seller.phone.presence || "—" %></p>
        </div>
        <div>
          <p class="text-gray-400 text-xs">Member Since</p>
          <p class="text-gray-700"><%= @seller.created_at.strftime("%B %d, %Y") %></p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200">
      <div class="px-6 py-4 border-b border-gray-200">
        <h3 class="font-semibold text-gray-800">Monthly Activity</h3>
      </div>
      <div class="divide-y divide-gray-100">
        <% @monthly_stats.each do |stat| %>
          <div class="px-6 py-2 flex items-center justify-between">
            <span class="text-xs text-gray-500"><%= stat[:month] %></span>
            <div class="text-right">
              <span class="text-xs text-gray-600"><%= stat[:orders] %> orders</span>
              <span class="text-xs text-green-600 ml-2 font-medium"><%= currency(stat[:revenue]) %></span>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
