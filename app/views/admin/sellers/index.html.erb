<% content_for :page_title, "Sellers" %>

<div class="flex items-center justify-between mb-6">
  <form method="get" class="flex gap-2">
    <input type="text" name="q" value="<%= params[:q] %>" placeholder="Search sellers..."
           class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-purple-500 w-64">
    <button type="submit" class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-4 py-2 rounded-lg text-sm">Search</button>
  </form>
  <%= link_to new_admin_user_path, class: "inline-flex items-center gap-2 bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-lg text-sm font-medium" do %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
    Add Seller
  <% end %>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
  <table class="w-full">
    <thead class="bg-gray-50 border-b border-gray-200">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Seller</th>
        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Company</th>
        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Joined</th>
        <th class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase">Customers</th>
        <th class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase">Orders</th>
        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Status</th>
        <th class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase">Actions</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% @sellers.each do |seller| %>
        <tr class="hover:bg-gray-50">
          <td class="px-6 py-4">
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 bg-purple-100 rounded-full flex items-center justify-center text-purple-700 font-semibold text-sm">
                <%= seller.display_name.first(2).upcase %>
              </div>
              <div>
                <p class="font-medium text-gray-800 text-sm"><%= seller.display_name %></p>
                <p class="text-xs text-gray-400"><%= seller.email %></p>
              </div>
            </div>
          </td>
          <td class="px-6 py-4 text-sm text-gray-600"><%= seller.company_name %></td>
          <td class="px-6 py-4 text-sm text-gray-500"><%= seller.created_at.strftime("%b %d, %Y") %></td>
          <td class="px-6 py-4 text-sm text-gray-800 font-medium text-right"><%= seller.customers.count %></td>
          <td class="px-6 py-4 text-sm text-gray-800 font-medium text-right"><%= seller.orders.count %></td>
          <td class="px-6 py-4">
            <% if seller.active? %>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-700">Active</span>
            <% else %>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-700">Inactive</span>
            <% end %>
          </td>
          <td class="px-6 py-4 text-right">
            <div class="flex items-center justify-end gap-2">
              <%= link_to "View", admin_seller_path(seller), class: "text-xs text-purple-600 hover:text-purple-800 font-medium" %>
              <%= button_to toggle_active_admin_seller_path(seller), method: :patch,
                  class: "text-xs #{seller.active? ? 'text-red-500 hover:text-red-700' : 'text-green-600 hover:text-green-800'} font-medium bg-transparent border-0 cursor-pointer p-0" do %>
                <%= seller.active? ? "Deactivate" : "Activate" %>
              <% end %>
              <%= link_to "Delete", admin_seller_path(seller), data: { "turbo-method": :delete, "turbo-confirm": "Delete seller #{seller.display_name}? This cannot be undone." }, class: "text-xs text-red-500 hover:text-red-700 font-medium" %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <div class="px-6 py-4 border-t border-gray-100">
    <%== pagy_nav(@pagy) %>
  </div>
</div>
