<%= form_with model: [:admin, user], class: "space-y-4" do |f| %>
  <%= render "shared/form_errors", object: user %>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <%= f.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :name, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.email_field :email, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :company_name, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :company_name, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :phone, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :phone, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :role, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :role, User.roles.keys.map { |r| [r.capitalize, r] },
          { prompt: "Select role" },
          { class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" } %>
    </div>
    <div>
      <%= f.label :password, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.password_field :password, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm", autocomplete: "new-password" %>
      <% if user.persisted? %><p class="text-xs text-gray-400 mt-1">Leave blank to keep current password</p><% end %>
    </div>
    <% if user.new_record? %>
      <div>
        <%= f.label :password_confirmation, "Confirm Password", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.password_field :password_confirmation, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" %>
      </div>
    <% end %>
  </div>
  <div class="flex items-center gap-2">
    <%= f.check_box :active, class: "h-4 w-4 text-purple-600 border-gray-300 rounded" %>
    <%= f.label :active, "Active account", class: "text-sm text-gray-700" %>
  </div>
  <div class="flex gap-3 pt-2">
    <%= f.submit user.new_record? ? "Create User" : "Save Changes", class: "bg-purple-600 hover:bg-purple-700 text-white px-6 py-2 rounded-lg text-sm font-medium cursor-pointer" %>
    <%= link_to "Cancel", admin_users_path, class: "border border-gray-300 text-gray-700 px-6 py-2 rounded-lg text-sm hover:bg-gray-50" %>
  </div>
<% end %>
