<% content_for :page_title, "Admin Dashboard" %>

<!-- Stats Grid -->
<div class="grid grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm text-gray-500 font-medium">Total Sellers</p>
        <p class="text-3xl font-bold text-gray-900 mt-1"><%= @total_sellers %></p>
        <p class="text-xs text-gray-400 mt-1"><%= @active_sellers %> active</p>
      </div>
      <div class="w-12 h-12 bg-purple-100 rounded-xl flex items-center justify-center">
        <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm text-gray-500 font-medium">Total Orders</p>
        <p class="text-3xl font-bold text-gray-900 mt-1"><%= @total_orders %></p>
        <p class="text-xs text-gray-400 mt-1"><%= @orders_today %> today</p>
      </div>
      <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center">
        <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm text-gray-500 font-medium">Total Customers</p>
        <p class="text-3xl font-bold text-gray-900 mt-1"><%= @total_customers %></p>
      </div>
      <div class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center">
        <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm text-gray-500 font-medium">Monthly Revenue</p>
        <p class="text-3xl font-bold text-green-600 mt-1"><%= currency(@monthly_revenue) %></p>
        <p class="text-xs text-gray-400 mt-1">Total: <%= currency(@total_revenue) %></p>
      </div>
      <div class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center">
        <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      </div>
    </div>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <!-- Monthly Stats Table -->
  <div class="lg:col-span-2 bg-white rounded-xl shadow-sm border border-gray-200">
    <div class="px-6 py-4 border-b border-gray-200">
      <h2 class="font-semibold text-gray-800">Monthly Statistics</h2>
    </div>
    <table class="w-full">
      <thead class="bg-gray-50 border-b border-gray-100">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Month</th>
          <th class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase">Orders</th>
          <th class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase">Revenue</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @monthly_stats.each do |stat| %>
          <tr>
            <td class="px-6 py-3 text-sm text-gray-700 font-medium"><%= stat[:month] %></td>
            <td class="px-6 py-3 text-sm text-gray-600 text-right"><%= stat[:orders] %></td>
            <td class="px-6 py-3 text-sm font-semibold text-gray-800 text-right"><%= currency(stat[:revenue]) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <!-- Top Sellers + Recent -->
  <div class="space-y-6">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200">
      <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
        <h2 class="font-semibold text-gray-800">Top Sellers</h2>
        <%= link_to "View all", admin_sellers_path, class: "text-xs text-purple-600 hover:text-purple-800" %>
      </div>
      <div class="divide-y divide-gray-100">
        <% if @top_sellers.empty? %>
          <div class="px-6 py-6 text-center text-gray-400 text-sm">No seller data yet</div>
        <% else %>
          <% @top_sellers.first(5).each do |seller| %>
            <div class="px-6 py-3 flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 bg-purple-100 rounded-full flex items-center justify-center text-purple-700 text-xs font-semibold">
                  <%= seller.display_name.first(2).upcase %>
                </div>
                <div>
                  <p class="text-sm font-medium text-gray-800"><%= seller.display_name %></p>
                  <p class="text-xs text-gray-400"><%= seller.orders_count %> orders</p>
                </div>
              </div>
              <span class="text-sm font-medium text-green-600"><%= currency(seller.total_revenue) %></span>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200">
      <div class="px-6 py-4 border-b border-gray-200">
        <h2 class="font-semibold text-gray-800">Recent Sellers</h2>
      </div>
      <div class="divide-y divide-gray-100">
        <% @recent_sellers.each do |seller| %>
          <div class="px-6 py-3 flex items-center justify-between">
            <div>
              <p class="text-sm font-medium text-gray-800"><%= seller.display_name %></p>
              <p class="text-xs text-gray-400">Joined <%= seller.created_at.strftime("%b %d, %Y") %></p>
            </div>
            <%= link_to "View", admin_seller_path(seller), class: "text-xs text-purple-600 hover:text-purple-800" %>
          </div>
        <% end %>
      </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
      <h2 class="font-semibold text-gray-800 mb-4">Platform Health</h2>
      <div class="space-y-3">
        <div class="flex justify-between text-sm">
          <span class="text-gray-500">Active Sellers</span>
          <span class="font-medium text-green-600"><%= @active_sellers %> / <%= @total_sellers %></span>
        </div>
        <div class="flex justify-between text-sm">
          <span class="text-gray-500">Unpaid Orders</span>
          <span class="font-medium text-yellow-600"><%= @unpaid_orders_count %></span>
        </div>
        <div class="flex justify-between text-sm">
          <span class="text-gray-500">Orders Today</span>
          <span class="font-medium text-blue-600"><%= @orders_today %></span>
        </div>
      </div>
    </div>
  </div>
</div>
