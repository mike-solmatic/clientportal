<% content_for :page_title, "Record Payment" %>

<div class="max-w-lg">
  <div class="flex items-center gap-4 mb-6">
    <%= link_to seller_order_path(@order), class: "text-gray-400 hover:text-gray-600" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    <% end %>
    <p class="text-gray-500 text-sm">Record a payment for order <%= @order.order_number %></p>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <div class="mb-6 p-4 bg-yellow-50 rounded-lg border border-yellow-200">
      <div class="flex justify-between text-sm">
        <span class="text-yellow-700">Order Total:</span>
        <span class="font-bold text-yellow-800"><%= currency(@order.total) %></span>
      </div>
      <div class="flex justify-between text-sm mt-1">
        <span class="text-yellow-700">Amount Paid:</span>
        <span class="font-medium text-green-700"><%= currency(@order.amount_paid) %></span>
      </div>
      <div class="flex justify-between text-sm mt-1 pt-1 border-t border-yellow-300">
        <span class="text-yellow-700 font-medium">Balance Due:</span>
        <span class="font-bold text-red-700"><%= currency(@order.amount_due) %></span>
      </div>
    </div>

    <%= form_with model: [:seller, @order, @payment] do |f| %>
      <div class="space-y-4">
        <div>
          <%= f.label :amount, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.number_field :amount, value: @order.amount_due, min: 0.01, step: 0.01,
              class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500" %>
        </div>
        <div>
          <%= f.label :payment_method, "Payment Method", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :payment_method, Payment.payment_methods.keys.map { |k| [k.humanize, k] },
              { prompt: "Select method" },
              { class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500" } %>
        </div>
        <div>
          <%= f.label :payment_date, "Payment Date", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.date_field :payment_date, value: Date.current, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500" %>
        </div>
        <div>
          <%= f.label :status, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :status, Payment.statuses.keys.map { |k| [k.humanize, k] },
              { selected: "completed" },
              { class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500" } %>
        </div>
        <div>
          <%= f.label :reference, "Reference / Check #", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :reference, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500", placeholder: "Transaction ID or check number" %>
        </div>
        <div>
          <%= f.label :notes, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_area :notes, rows: 2, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500" %>
        </div>
      </div>
      <div class="flex gap-3 mt-6">
        <%= f.submit "Record Payment", class: "bg-green-600 hover:bg-green-700 text-white px-6 py-2 rounded-lg text-sm font-medium cursor-pointer" %>
        <%= link_to "Cancel", seller_order_path(@order), class: "border border-gray-300 text-gray-700 px-6 py-2 rounded-lg text-sm hover:bg-gray-50" %>
      </div>
    <% end %>
  </div>
</div>
