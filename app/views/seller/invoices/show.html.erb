<% content_for :page_title, "Invoice #{@invoice.invoice_number}" %>

<div class="flex items-center gap-4 mb-6">
  <%= link_to seller_order_path(@order), class: "text-gray-400 hover:text-gray-600" do %>
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
  <% end %>
  <div class="flex-1 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <h2 class="text-lg font-bold text-gray-800"><%= @invoice.invoice_number %></h2>
      <%= status_badge(@invoice.status) %>
    </div>
    <%= link_to "Download PDF", pdf_seller_order_invoice_path(@order), class: "inline-flex items-center gap-2 bg-indigo-600 text-white px-4 py-2 rounded-lg text-sm hover:bg-indigo-700" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
      Download PDF
    <% end %>
  </div>
</div>

<div class="max-w-3xl">
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8">
    <!-- Invoice Header -->
    <div class="flex items-start justify-between mb-8">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">INVOICE</h1>
        <p class="text-gray-500 mt-1"># <%= @invoice.invoice_number %></p>
      </div>
      <div class="text-right text-sm text-gray-600">
        <p class="font-semibold text-gray-800"><%= current_user.company_name.presence || current_user.display_name %></p>
        <p><%= current_user.email %></p>
        <p><%= current_user.phone %></p>
      </div>
    </div>

    <!-- Dates and Bill To -->
    <div class="grid grid-cols-2 gap-8 mb-8">
      <div>
        <p class="text-xs text-gray-400 uppercase font-semibold mb-2">Bill To</p>
        <p class="font-semibold text-gray-800"><%= @order.customer.name %></p>
        <p class="text-sm text-gray-600"><%= @order.customer.company_name %></p>
        <p class="text-sm text-gray-600"><%= @order.customer.email %></p>
        <p class="text-sm text-gray-600"><%= @order.customer.phone %></p>
        <p class="text-sm text-gray-600 whitespace-pre-line"><%= @order.customer.address %></p>
      </div>
      <div class="text-right">
        <div class="space-y-2 text-sm">
          <div>
            <span class="text-gray-400">Issue Date:</span>
            <span class="text-gray-800 ml-2 font-medium"><%= @invoice.issued_date&.strftime("%B %d, %Y") %></span>
          </div>
          <div>
            <span class="text-gray-400">Due Date:</span>
            <span class="text-gray-800 ml-2 font-medium"><%= @invoice.due_date&.strftime("%B %d, %Y") %></span>
          </div>
          <div>
            <span class="text-gray-400">Order #:</span>
            <span class="text-gray-800 ml-2 font-mono text-xs"><%= @order.order_number %></span>
          </div>
        </div>
      </div>
    </div>

    <!-- Items Table -->
    <table class="w-full mb-6 border border-gray-200 rounded-lg overflow-hidden">
      <thead class="bg-gray-800 text-white">
        <tr>
          <th class="px-4 py-3 text-left text-sm font-medium">Description</th>
          <th class="px-4 py-3 text-center text-sm font-medium">Qty</th>
          <th class="px-4 py-3 text-right text-sm font-medium">Unit Price</th>
          <th class="px-4 py-3 text-right text-sm font-medium">Amount</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @order.order_items.each do |item| %>
          <tr>
            <td class="px-4 py-3 text-sm text-gray-800"><%= item.description %></td>
            <td class="px-4 py-3 text-sm text-center text-gray-600"><%= item.quantity %></td>
            <td class="px-4 py-3 text-sm text-right text-gray-600"><%= currency(item.unit_price) %></td>
            <td class="px-4 py-3 text-sm text-right font-medium text-gray-800"><%= currency(item.total) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <!-- Totals -->
    <div class="flex justify-end">
      <div class="w-64 space-y-2 text-sm">
        <div class="flex justify-between">
          <span class="text-gray-500">Subtotal</span>
          <span class="font-medium"><%= currency(@invoice.subtotal) %></span>
        </div>
        <% if @invoice.tax > 0 %>
          <div class="flex justify-between">
            <span class="text-gray-500">Tax</span>
            <span class="font-medium"><%= currency(@invoice.tax) %></span>
          </div>
        <% end %>
        <div class="flex justify-between border-t pt-2">
          <span class="font-bold text-gray-800 text-base">Total</span>
          <span class="font-bold text-gray-900 text-xl"><%= currency(@invoice.total) %></span>
        </div>
        <% paid = @invoice.payments.where(status: :completed).sum(:amount) %>
        <% if paid > 0 %>
          <div class="flex justify-between text-green-600">
            <span>Amount Paid</span>
            <span class="font-medium">- <%= currency(paid) %></span>
          </div>
          <div class="flex justify-between border-t pt-2">
            <span class="font-bold text-gray-800">Balance Due</span>
            <span class="font-bold text-red-600 text-base"><%= currency(@invoice.total - paid) %></span>
          </div>
        <% end %>
      </div>
    </div>

    <% if @invoice.notes.present? %>
      <div class="mt-8 pt-6 border-t border-gray-200">
        <p class="text-xs text-gray-400 uppercase font-semibold mb-1">Notes</p>
        <p class="text-sm text-gray-600"><%= @invoice.notes %></p>
      </div>
    <% end %>
  </div>
</div>
