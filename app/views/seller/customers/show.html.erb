<% content_for :page_title, @customer.name %>

<div class="flex items-center gap-4 mb-6">
  <%= link_to seller_customers_path, class: "text-gray-400 hover:text-gray-600" do %>
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
  <% end %>
  <div class="flex-1">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-12 h-12 bg-indigo-100 rounded-full flex items-center justify-center text-indigo-700 font-bold text-lg">
          <%= @customer.name.first(2).upcase %>
        </div>
        <div>
          <h2 class="text-lg font-bold text-gray-800"><%= @customer.name %></h2>
          <p class="text-sm text-gray-400"><%= @customer.company_name %></p>
        </div>
      </div>
      <div class="flex gap-2">
        <%= link_to edit_seller_customer_path(@customer), class: "inline-flex items-center gap-2 border border-gray-300 text-gray-700 px-4 py-2 rounded-lg text-sm hover:bg-gray-50" do %>
          Edit Customer
        <% end %>
        <%= link_to new_seller_order_path(customer_id: @customer.id), class: "inline-flex items-center gap-2 bg-indigo-600 text-white px-4 py-2 rounded-lg text-sm hover:bg-indigo-700" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          New Order
        <% end %>
      </div>
    </div>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="lg:col-span-1 space-y-6">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
      <h3 class="font-semibold text-gray-800 mb-4">Contact Info</h3>
      <div class="space-y-3">
        <% if @customer.email.present? %>
          <div class="flex items-center gap-3 text-sm">
            <svg class="w-4 h-4 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <span class="text-gray-600"><%= @customer.email %></span>
          </div>
        <% end %>
        <% if @customer.phone.present? %>
          <div class="flex items-center gap-3 text-sm">
            <svg class="w-4 h-4 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            <span class="text-gray-600"><%= @customer.phone %></span>
          </div>
        <% end %>
        <% if @customer.address.present? %>
          <div class="flex items-start gap-3 text-sm">
            <svg class="w-4 h-4 text-gray-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <span class="text-gray-600 whitespace-pre-line"><%= @customer.address %></span>
          </div>
        <% end %>
        <% if @customer.notes.present? %>
          <div class="mt-4 pt-4 border-t border-gray-100">
            <p class="text-xs text-gray-400 mb-1">Notes</p>
            <p class="text-sm text-gray-600"><%= @customer.notes %></p>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="lg:col-span-2">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200">
      <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
        <h3 class="font-semibold text-gray-800">Order History</h3>
        <span class="text-sm text-gray-400"><%= @orders.count %> orders</span>
      </div>
      <% if @orders.empty? %>
        <div class="py-10 text-center text-gray-400 text-sm">No orders yet for this customer</div>
      <% else %>
        <table class="w-full">
          <thead class="bg-gray-50 border-b border-gray-200">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Order #</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Date</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Status</th>
              <th class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase">Total</th>
              <th class="px-6 py-3"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @orders.each do |order| %>
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-3 text-sm font-medium text-gray-800"><%= order.order_number %></td>
                <td class="px-6 py-3 text-sm text-gray-500"><%= order.created_at.strftime("%b %d, %Y") %></td>
                <td class="px-6 py-3"><%= status_badge(order.status) %></td>
                <td class="px-6 py-3 text-sm font-semibold text-gray-800 text-right"><%= currency(order.total) %></td>
                <td class="px-6 py-3 text-right"><%= link_to "View", seller_order_path(order), class: "text-xs text-indigo-600 hover:text-indigo-800" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    </div>
  </div>
</div>
