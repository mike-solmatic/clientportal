<% content_for :page_title, "Customers" %>

<div class="flex items-center justify-between mb-6">
  <div>
    <p class="text-gray-500 text-sm">Manage your customer directory</p>
  </div>
  <%= link_to new_seller_customer_path, class: "inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors" do %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
    New Customer
  <% end %>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
  <% if @customers.empty? %>
    <div class="py-16 text-center text-gray-400">
      <svg class="w-16 h-16 mx-auto mb-4 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
      <p class="text-lg font-medium">No customers yet</p>
      <p class="text-sm mt-1">Add your first customer to get started</p>
      <%= link_to "Add Customer", new_seller_customer_path, class: "mt-4 inline-block bg-indigo-600 text-white px-4 py-2 rounded-lg text-sm hover:bg-indigo-700" %>
    </div>
  <% else %>
    <table class="w-full">
      <thead class="bg-gray-50 border-b border-gray-200">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Customer</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Contact</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Company</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
          <th class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @customers.each do |customer| %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4">
              <div class="flex items-center gap-3">
                <div class="w-9 h-9 bg-indigo-100 rounded-full flex items-center justify-center text-indigo-700 font-semibold text-sm">
                  <%= customer.name.first(2).upcase %>
                </div>
                <div>
                  <p class="font-medium text-gray-800"><%= customer.name %></p>
                </div>
              </div>
            </td>
            <td class="px-6 py-4">
              <p class="text-sm text-gray-600"><%= customer.email %></p>
              <p class="text-xs text-gray-400"><%= customer.phone %></p>
            </td>
            <td class="px-6 py-4 text-sm text-gray-600"><%= customer.company_name %></td>
            <td class="px-6 py-4">
              <% if customer.active? %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-700">Active</span>
              <% else %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">Inactive</span>
              <% end %>
            </td>
            <td class="px-6 py-4 text-right">
              <div class="flex items-center justify-end gap-2">
                <%= link_to "View", seller_customer_path(customer), class: "text-xs text-indigo-600 hover:text-indigo-800 font-medium" %>
                <%= link_to "Edit", edit_seller_customer_path(customer), class: "text-xs text-gray-500 hover:text-gray-700 font-medium" %>
                <%= link_to "Delete", seller_customer_path(customer), data: { "turbo-method": :delete, "turbo-confirm": "Delete this customer?" }, class: "text-xs text-red-500 hover:text-red-700 font-medium" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <div class="px-6 py-4 border-t border-gray-100">
      <%== pagy_nav(@pagy) %>
    </div>
  <% end %>
</div>
