<% content_for :page_title, @order.order_number %>

<div class="flex items-center gap-4 mb-6">
  <%= link_to seller_orders_path, class: "text-gray-400 hover:text-gray-600" do %>
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
  <% end %>
  <div class="flex-1 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <h2 class="text-lg font-bold text-gray-800"><%= @order.order_number %></h2>
      <%= status_badge(@order.status) %>
    </div>
    <div class="flex gap-2">
      <% unless @order.paid? || @order.cancelled? %>
        <%= link_to edit_seller_order_path(@order), class: "border border-gray-300 text-gray-700 px-3 py-1.5 rounded-lg text-sm hover:bg-gray-50" %>
        <% if @order.draft? || @order.pending? %>
          <%= button_to confirm_seller_order_path(@order), method: :patch, class: "bg-blue-600 text-white px-3 py-1.5 rounded-lg text-sm hover:bg-blue-700" do %>Confirm<% end %>
        <% end %>
        <%= button_to cancel_seller_order_path(@order), method: :patch, data: { "turbo-confirm": "Cancel this order?" }, class: "bg-red-100 text-red-700 px-3 py-1.5 rounded-lg text-sm hover:bg-red-200" do %>Cancel<% end %>
      <% end %>
    </div>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2 space-y-6">
    <!-- Order Items -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200">
      <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
        <h3 class="font-semibold text-gray-800">Order Items</h3>
        <% unless @order.paid? || @order.cancelled? %>
          <%= link_to new_seller_order_order_item_path(@order), class: "text-sm text-indigo-600 hover:text-indigo-800" do %>
            + Add Item
          <% end %>
        <% end %>
      </div>
      <% if @order_items.empty? %>
        <div class="py-8 text-center text-gray-400 text-sm">No items added yet</div>
      <% else %>
        <table class="w-full">
          <thead class="bg-gray-50 border-b border-gray-100">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Description</th>
              <th class="px-6 py-3 text-center text-xs font-semibold text-gray-500 uppercase">Qty</th>
              <th class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase">Unit Price</th>
              <th class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase">Total</th>
              <% unless @order.paid? || @order.cancelled? %>
                <th class="px-6 py-3"></th>
              <% end %>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @order_items.each do |item| %>
              <tr>
                <td class="px-6 py-3 text-sm text-gray-800">
                  <%= item.description %>
                  <% if item.product %>
                    <span class="text-xs text-gray-400 ml-1">(<%= item.product.name %>)</span>
                  <% end %>
                </td>
                <td class="px-6 py-3 text-sm text-center text-gray-600"><%= item.quantity %></td>
                <td class="px-6 py-3 text-sm text-right text-gray-600"><%= currency(item.unit_price) %></td>
                <td class="px-6 py-3 text-sm text-right font-medium text-gray-800"><%= currency(item.total) %></td>
                <% unless @order.paid? || @order.cancelled? %>
                  <td class="px-6 py-3 text-right">
                    <%= link_to "Remove", seller_order_order_item_path(@order, item), data: { "turbo-method": :delete, "turbo-confirm": "Remove this item?" }, class: "text-xs text-red-500 hover:text-red-700" %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
          <tfoot class="bg-gray-50 border-t border-gray-200">
            <tr>
              <td colspan="<%= @order.paid? || @order.cancelled? ? 3 : 3 %>" class="px-6 py-3 text-sm text-gray-500 text-right">Subtotal</td>
              <td class="px-6 py-3 text-sm font-medium text-right"><%= currency(@order.subtotal) %></td>
              <% unless @order.paid? || @order.cancelled? %><td></td><% end %>
            </tr>
            <% if @order.tax > 0 %>
              <tr>
                <td colspan="3" class="px-6 py-2 text-sm text-gray-500 text-right">Tax</td>
                <td class="px-6 py-2 text-sm text-right"><%= currency(@order.tax) %></td>
                <% unless @order.paid? || @order.cancelled? %><td></td><% end %>
              </tr>
            <% end %>
            <tr>
              <td colspan="3" class="px-6 py-3 text-sm font-bold text-gray-800 text-right">Total</td>
              <td class="px-6 py-3 text-base font-bold text-gray-900 text-right"><%= currency(@order.total) %></td>
              <% unless @order.paid? || @order.cancelled? %><td></td><% end %>
            </tr>
          </tfoot>
        </table>
      <% end %>
    </div>

    <!-- Payments -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200">
      <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
        <h3 class="font-semibold text-gray-800">Payments</h3>
        <div class="flex items-center gap-4">
          <% if @order.amount_due > 0 %>
            <span class="text-sm text-red-600 font-medium">Due: <%= currency(@order.amount_due) %></span>
          <% end %>
          <% unless @order.cancelled? || @order.draft? %>
            <%= link_to new_seller_order_payment_path(@order), class: "text-sm text-indigo-600 hover:text-indigo-800" do %>
              + Record Payment
            <% end %>
          <% end %>
        </div>
      </div>
      <% if @payments.empty? %>
        <div class="py-8 text-center text-gray-400 text-sm">No payments recorded</div>
      <% else %>
        <table class="w-full">
          <thead class="bg-gray-50 border-b border-gray-100">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Date</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Method</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Reference</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Status</th>
              <th class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase">Amount</th>
              <th class="px-6 py-3"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @payments.each do |payment| %>
              <tr>
                <td class="px-6 py-3 text-sm text-gray-700"><%= payment.payment_date&.strftime("%b %d, %Y") %></td>
                <td class="px-6 py-3 text-sm text-gray-600 capitalize"><%= payment.payment_method.to_s.humanize %></td>
                <td class="px-6 py-3 text-sm text-gray-400"><%= payment.reference %></td>
                <td class="px-6 py-3"><%= status_badge(payment.status) %></td>
                <td class="px-6 py-3 text-sm font-semibold text-gray-800 text-right"><%= currency(payment.amount) %></td>
                <td class="px-6 py-3 text-right">
                  <%= link_to "Remove", seller_order_payment_path(@order, payment), data: { "turbo-method": :delete, "turbo-confirm": "Remove this payment?" }, class: "text-xs text-red-500 hover:text-red-700" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    </div>
  </div>

  <!-- Sidebar -->
  <div class="space-y-6">
    <!-- Customer Info -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
      <h3 class="font-semibold text-gray-800 mb-3">Customer</h3>
      <div class="flex items-center gap-3 mb-3">
        <div class="w-10 h-10 bg-indigo-100 rounded-full flex items-center justify-center text-indigo-700 font-semibold">
          <%= @order.customer.name.first(2).upcase %>
        </div>
        <div>
          <p class="font-medium text-gray-800 text-sm"><%= @order.customer.name %></p>
          <p class="text-xs text-gray-400"><%= @order.customer.company_name %></p>
        </div>
      </div>
      <div class="space-y-1 text-xs text-gray-500">
        <p><%= @order.customer.email %></p>
        <p><%= @order.customer.phone %></p>
      </div>
      <%= link_to "View Customer", seller_customer_path(@order.customer), class: "mt-3 block text-xs text-indigo-600 hover:text-indigo-800" %>
    </div>

    <!-- Order Details -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
      <h3 class="font-semibold text-gray-800 mb-3">Order Details</h3>
      <div class="space-y-2 text-sm">
        <div class="flex justify-between">
          <span class="text-gray-500">Created</span>
          <span class="text-gray-800"><%= @order.created_at.strftime("%b %d, %Y") %></span>
        </div>
        <% if @order.due_date %>
          <div class="flex justify-between">
            <span class="text-gray-500">Due Date</span>
            <span class="<%= @order.due_date < Date.current && !@order.paid? ? 'text-red-600 font-medium' : 'text-gray-800' %>">
              <%= @order.due_date.strftime("%b %d, %Y") %>
            </span>
          </div>
        <% end %>
        <div class="flex justify-between">
          <span class="text-gray-500">Total</span>
          <span class="font-bold text-gray-900"><%= currency(@order.total) %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-500">Paid</span>
          <span class="text-green-600 font-medium"><%= currency(@order.amount_paid) %></span>
        </div>
        <div class="flex justify-between border-t pt-2">
          <span class="text-gray-500">Balance Due</span>
          <span class="<%= @order.amount_due > 0 ? 'text-red-600' : 'text-green-600' %> font-bold">
            <%= currency(@order.amount_due) %>
          </span>
        </div>
      </div>
    </div>

    <!-- Invoice -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
      <div class="flex items-center justify-between mb-3">
        <h3 class="font-semibold text-gray-800">Invoice</h3>
      </div>
      <% if @invoice %>
        <div class="space-y-2 text-sm">
          <div class="flex justify-between">
            <span class="text-gray-500">Number</span>
            <span class="text-gray-800 font-mono text-xs"><%= @invoice.invoice_number %></span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-500">Status</span>
            <%= status_badge(@invoice.status) %>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-500">Due</span>
            <span class="text-gray-800"><%= @invoice.due_date&.strftime("%b %d, %Y") %></span>
          </div>
        </div>
        <div class="flex gap-2 mt-3">
          <%= link_to "View Invoice", seller_order_invoice_path(@order), class: "flex-1 text-center text-xs border border-indigo-200 text-indigo-600 py-1.5 rounded-lg hover:bg-indigo-50" %>
          <%= link_to "Download PDF", pdf_seller_order_invoice_path(@order), class: "flex-1 text-center text-xs bg-indigo-600 text-white py-1.5 rounded-lg hover:bg-indigo-700" %>
        </div>
      <% else %>
        <p class="text-sm text-gray-400 mb-3">No invoice created yet</p>
        <% unless @order.draft? || @order.cancelled? %>
          <%= link_to new_seller_order_invoice_path(@order), class: "w-full text-center text-sm bg-indigo-600 text-white py-2 rounded-lg hover:bg-indigo-700 block" do %>
            Create Invoice
          <% end %>
        <% end %>
      <% end %>
    </div>

    <% if @order.notes.present? %>
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        <h3 class="font-semibold text-gray-800 mb-2">Notes</h3>
        <p class="text-sm text-gray-600"><%= @order.notes %></p>
      </div>
    <% end %>
  </div>
</div>
