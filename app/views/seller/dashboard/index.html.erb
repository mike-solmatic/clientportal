<% content_for :page_title, "Dashboard" %>

<!-- Stats Grid -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm text-gray-500 font-medium">Today's Orders</p>
        <p class="text-3xl font-bold text-gray-900 mt-1"><%= @orders_today %></p>
      </div>
      <div class="w-12 h-12 bg-indigo-100 rounded-xl flex items-center justify-center">
        <svg class="w-6 h-6 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm text-gray-500 font-medium">Unpaid Orders</p>
        <p class="text-3xl font-bold text-yellow-600 mt-1"><%= @unpaid_orders_count %></p>
        <p class="text-xs text-gray-400 mt-1"><%= currency(@unpaid_total) %> outstanding</p>
      </div>
      <div class="w-12 h-12 bg-yellow-100 rounded-xl flex items-center justify-center">
        <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm text-gray-500 font-medium">Total Customers</p>
        <p class="text-3xl font-bold text-gray-900 mt-1"><%= @customers_count %></p>
      </div>
      <div class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center">
        <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm text-gray-500 font-medium">Monthly Revenue</p>
        <p class="text-3xl font-bold text-green-600 mt-1"><%= currency(@monthly_revenue) %></p>
        <p class="text-xs text-gray-400 mt-1">Total: <%= currency(@total_revenue) %></p>
      </div>
      <div class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center">
        <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      </div>
    </div>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <!-- Recent Orders -->
  <div class="lg:col-span-2 bg-white rounded-xl shadow-sm border border-gray-200">
    <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
      <h2 class="font-semibold text-gray-800">Recent Orders</h2>
      <%= link_to "View all", seller_orders_path, class: "text-sm text-indigo-600 hover:text-indigo-800" %>
    </div>
    <div class="divide-y divide-gray-100">
      <% if @recent_orders.empty? %>
        <div class="px-6 py-8 text-center text-gray-400">
          <svg class="w-12 h-12 mx-auto mb-3 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
          <p>No orders yet</p>
          <%= link_to "Create your first order", new_seller_order_path, class: "text-indigo-600 hover:underline text-sm mt-2 inline-block" %>
        </div>
      <% else %>
        <% @recent_orders.each do |order| %>
          <div class="px-6 py-4 flex items-center justify-between hover:bg-gray-50">
            <div class="flex items-center gap-4">
              <div class="w-10 h-10 bg-indigo-100 rounded-lg flex items-center justify-center text-indigo-700 font-semibold text-sm">
                <%= order.customer.name.first(2).upcase %>
              </div>
              <div>
                <p class="font-medium text-gray-800 text-sm"><%= order.order_number %></p>
                <p class="text-xs text-gray-400"><%= order.customer.name %></p>
              </div>
            </div>
            <div class="flex items-center gap-4">
              <%= status_badge(order.status) %>
              <span class="font-semibold text-gray-800 text-sm"><%= currency(order.total) %></span>
              <%= link_to "View", seller_order_path(order), class: "text-xs text-indigo-600 hover:text-indigo-800" %>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Quick Actions + Top Customers -->
  <div class="space-y-6">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
      <h2 class="font-semibold text-gray-800 mb-4">Quick Actions</h2>
      <div class="space-y-3">
        <%= link_to new_seller_order_path, class: "flex items-center gap-3 p-3 bg-indigo-50 hover:bg-indigo-100 rounded-lg transition-colors" do %>
          <div class="w-8 h-8 bg-indigo-200 rounded-lg flex items-center justify-center">
            <svg class="w-4 h-4 text-indigo-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          </div>
          <span class="text-sm font-medium text-indigo-700">New Order</span>
        <% end %>
        <%= link_to new_seller_customer_path, class: "flex items-center gap-3 p-3 bg-green-50 hover:bg-green-100 rounded-lg transition-colors" do %>
          <div class="w-8 h-8 bg-green-200 rounded-lg flex items-center justify-center">
            <svg class="w-4 h-4 text-green-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
          </div>
          <span class="text-sm font-medium text-green-700">New Customer</span>
        <% end %>
        <%= link_to seller_orders_path(status: "pending"), class: "flex items-center gap-3 p-3 bg-yellow-50 hover:bg-yellow-100 rounded-lg transition-colors" do %>
          <div class="w-8 h-8 bg-yellow-200 rounded-lg flex items-center justify-center">
            <svg class="w-4 h-4 text-yellow-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <span class="text-sm font-medium text-yellow-700">Unpaid Orders (<%= @unpaid_orders_count %>)</span>
        <% end %>
      </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200">
      <div class="px-6 py-4 border-b border-gray-200">
        <h2 class="font-semibold text-gray-800">Top Customers</h2>
      </div>
      <div class="divide-y divide-gray-100">
        <% if @top_customers.empty? %>
          <div class="px-6 py-6 text-center text-gray-400 text-sm">No customers yet</div>
        <% else %>
          <% @top_customers.each do |customer| %>
            <div class="px-6 py-3 flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 bg-gray-100 rounded-full flex items-center justify-center text-gray-600 text-xs font-semibold">
                  <%= customer.name.first(2).upcase %>
                </div>
                <span class="text-sm text-gray-700"><%= customer.name %></span>
              </div>
              <span class="text-sm font-medium text-green-600"><%= currency(customer.total_spent) %></span>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>
