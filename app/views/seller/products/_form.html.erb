<%= form_with model: [:seller, product], class: "space-y-4" do |f| %>
  <%= render "shared/form_errors", object: product %>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <%= f.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :name, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500" %>
    </div>
    <div>
      <%= f.label :unit, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :unit, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500", placeholder: "e.g., each, hr, kg" %>
    </div>
    <div>
      <%= f.label :price, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :price, step: 0.01, min: 0, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500" %>
    </div>
    <div class="flex items-end pb-2">
      <label class="flex items-center gap-2">
        <%= f.check_box :active, class: "h-4 w-4 text-indigo-600 border-gray-300 rounded" %>
        <span class="text-sm text-gray-700">Active</span>
      </label>
    </div>
  </div>
  <div>
    <%= f.label :description, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_area :description, rows: 3, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500" %>
  </div>
  <div class="flex gap-3 pt-2">
    <%= f.submit product.new_record? ? "Create Product" : "Save Changes", class: "bg-indigo-600 hover:bg-indigo-700 text-white px-6 py-2 rounded-lg text-sm font-medium cursor-pointer" %>
    <%= link_to "Cancel", seller_products_path, class: "border border-gray-300 text-gray-700 px-6 py-2 rounded-lg text-sm hover:bg-gray-50" %>
  </div>
<% end %>
